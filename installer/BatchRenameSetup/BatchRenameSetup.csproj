<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <AssemblyName>BatchRenameSetup</AssemblyName>
    <RootNamespace>BatchRename.Setup</RootNamespace>
    <ApplicationIcon>..\..\src\BatchRename.App\app.ico</ApplicationIcon>
    <AssemblyTitle>批量重命名 安装程序</AssemblyTitle>
  </PropertyGroup>

  <!--
    payload.zip 由 tools/Build-Setup.ps1 在编译前生成（内容即 Package-Portable 的产物）。
    用 EmbeddedResource 而不是复制到输出目录，才能保证最终是"单个 exe"。
  -->
  <ItemGroup>
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')">
      <LogicalName>payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    payload 缺失时明确报错，而不是让 Include 的 Exists 条件静默跳过。
    踩过的坑：忘了生成 payload，exe 从 97MB 掉到 36MB，看起来像"体积优化成功"，
    实际装上去会发现没有任何文件。
    只在发布时检查，日常 build 不受影响。
  -->
  <Target Name="EnsurePayload" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\payload.zip')"
           Text="缺少 payload.zip。请先运行 tools\Build-Setup.ps1（它会自动生成并复制过来）。" />
  </Target>

</Project>
