<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BatchRename.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BatchRename.App.Models"
    xmlns:local="using:BatchRename.App"
    Title="批量重命名">

    <Grid Padding="16" RowSpacing="10">
        <Grid.Resources>
            <local:StateToBrushConverter x:Key="StateBrush" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. 标题 + 汇总 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="批量重命名" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="SummaryText"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 1. 规则工具条 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="FindBox" Width="170" PlaceholderText="查找"
                     TextChanged="OnRuleChanged" />
            <TextBox x:Name="ReplaceBox" Width="170" PlaceholderText="替换为"
                     TextChanged="OnRuleChanged" />

            <ComboBox x:Name="ScopeBox" Width="120" SelectedIndex="0" SelectionChanged="OnRuleChanged">
                <ComboBoxItem Content="两者" />
                <ComboBoxItem Content="仅文件名" />
                <ComboBoxItem Content="仅扩展名" />
            </ComboBox>

            <ComboBox x:Name="CaseBox" Width="140" SelectedIndex="0" SelectionChanged="OnRuleChanged">
                <ComboBoxItem Content="不转换" />
                <ComboBoxItem Content="全大写" />
                <ComboBoxItem Content="全小写" />
                <ComboBoxItem Content="每词首字母大写" />
            </ComboBox>

            <CheckBox x:Name="CaseSensitiveBox" Content="区分大小写" Click="OnRuleChanged" />
            <CheckBox x:Name="RegexBox" Content="正则" Click="OnRuleChanged" />
        </StackPanel>

        <!-- 2. 错误横幅 -->
        <InfoBar Grid.Row="2" x:Name="ErrorBar" Severity="Error" IsOpen="False" />

        <!-- 3. 两栏预览 -->
        <Border Grid.Row="3"
                BorderThickness="1"
                CornerRadius="8"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ListView x:Name="ItemList" SelectionMode="None">
                <ListView.Header>
                    <Grid Padding="12,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="原名称"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="新名称"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="状态"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <!--
                        这里用 {Binding} 而不是 {x:Bind}：Window 不是 FrameworkElement，
                        x:Bind 生成的代码在 Window 根下无法编译（MainWindow.g.cs 会报 CS1503）。
                        ListView 有 UI 虚拟化，运行时绑定开销可以忽略。
                    -->
                    <DataTemplate>
                        <Grid Padding="0,2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      MinWidth="0"
                                      Click="OnItemEnabledChanged"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding OriginalName}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />

                            <FontIcon Grid.Column="2"
                                      Glyph="&#xE72A;"
                                      FontSize="12"
                                      Opacity="0.4"
                                      VerticalAlignment="Center" />

                            <TextBlock Grid.Column="3"
                                       Text="{Binding NewName}"
                                       Foreground="{Binding State, Converter={StaticResource StateBrush}}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="4"
                                       Text="{Binding Message}"
                                       Foreground="{Binding State, Converter={StaticResource StateBrush}}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- 4. 底栏 -->
        <TextBlock Grid.Row="4" x:Name="FooterText"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Window>
