<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BatchRename.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BatchRename.App"
    Title="批量重命名">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <local:StateToBrushConverter x:Key="StateBrush" />
            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />

            <!--
                状态列颜色：**交给 XAML 解析 ThemeResource**，代码只取现成的画刷对象。
                为什么不用代码去查主题字典：WinUI 3 的 XamlControlsResources.ThemeDictionaries
                是按启动时的主题固化的——实测在深色下取 "Light" 字典，拿到的仍是深色值
                （TextFillColorSecondary 两个键都是 #C5FFFFFF）。而 ThemeResource 在这里会随
                系统深浅色/高对比度实时换值，且换的是同一个 SolidColorBrush 实例的 Color，
                所以列表里已绑定的行会自动更新，不需要重挂 ItemsSource。
            -->
            <SolidColorBrush x:Key="RowStateCritical"  Color="{ThemeResource SystemFillColorCritical}" />
            <SolidColorBrush x:Key="RowStateCaution"   Color="{ThemeResource SystemFillColorCaution}" />
            <SolidColorBrush x:Key="RowStateSuccess"   Color="{ThemeResource SystemFillColorSuccess}" />
            <!-- AccentTextFillColorPrimary 这个 Color 键在 WinUI 3 里不存在（只有 …Brush 版本），
                 所以用资源别名指向那支 brush，主题解析仍然由 XAML 负责 -->
            <StaticResource x:Key="RowStateAccent" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <SolidColorBrush x:Key="RowStateSecondary" Color="{ThemeResource TextFillColorSecondary}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏：与系统 caption 同高（32px） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Padding="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE8AC;" FontSize="12" />
                <TextBlock Text="批量重命名" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- 只有一屏内容，没有独立的底部行：按钮进左栏，结果条进卡片 -->
        <Grid Grid.Row="1" Padding="16,0,16,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左：操作区（底部为撤销/执行） ============ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled">
                    <!-- 不加顶部 padding：这样第一个控件和右侧卡片顶边严格对齐 -->
                    <StackPanel Spacing="14">
                        <TextBox x:Name="FindBox" PlaceholderText="查找"
                                 TextChanged="OnRuleChanged" />

                        <CheckBox x:Name="CaseSensitiveBox" Content="区分大小写"
                                  MinWidth="0" Click="OnRuleChanged" />

                        <CheckBox x:Name="RegexBox" Content="使用正则表达式"
                                  MinWidth="0" Click="OnRuleChanged" />

                        <TextBox x:Name="ReplaceBox" PlaceholderText="替换为"
                                 TextChanged="OnRuleChanged" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="应用于" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="ScopeBox" HorizontalAlignment="Stretch"
                                      SelectedIndex="0" SelectionChanged="OnRuleChanged">
                                <ComboBoxItem Content="两者" />
                                <ComboBoxItem Content="仅文件名" />
                                <ComboBoxItem Content="仅扩展名" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="转换大小写" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="CaseBox" HorizontalAlignment="Stretch"
                                      SelectedIndex="0" SelectionChanged="OnRuleChanged">
                                <ComboBoxItem Content="不转换" />
                                <ComboBoxItem Content="全大写" />
                                <ComboBoxItem Content="全小写" />
                                <ComboBoxItem Content="每词首字母大写" />
                            </ComboBox>
                        </StackPanel>

                        <CheckBox x:Name="AutoNumberBox" Content="冲突时自动编号"
                                  MinWidth="0" Click="OnRuleChanged" />

                        <!-- §10.3：26H2 默认把扩展收进「应用扩展」，给一条直达设置的路 -->
                        <HyperlinkButton Content="命令没出现在右键菜单？"
                                         FontSize="12" Padding="0"
                                         Click="OnOpenContextMenuSettings" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8" Margin="0,10,0,0">
                    <CheckBox x:Name="SelectAllBox" Content="全选"
                              MinWidth="0" IsChecked="True" IsThreeState="True"
                              Click="OnSelectAllClick" />
                    <Button x:Name="UndoButton" Content="撤销" Click="OnUndo" IsEnabled="False">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Z" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button x:Name="ExecuteButton" Content="执行" Click="OnExecute"
                            IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>

            <!-- ============ 右：预览卡片（结果条固定在卡片内底部） ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 用 Visibility 而不是 IsOpen 控制显隐：收起的 InfoBar 不能占位，
                     否则卡片会被它顶下去，和左栏第一行错位 -->
                <InfoBar Grid.Row="0" x:Name="ErrorBar"
                         Severity="Error"
                         Visibility="Collapsed"
                         Margin="0,0,0,8" />

                <Border Grid.Row="1"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                            表头吸顶（M3 遗留）：原来放在 ListView.Header 里，会跟着列表一起滚走。
                            现在移出列表当成固定行；列宽与行模板一致（40/*/28/*/110），
                            左边距也对齐（12 = 列表项内容的默认内缩）。
                        -->
                        <Border Grid.Row="0" Padding="12,8"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="原名称"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="新名称"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Text="状态"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Border>

                        <ListView Grid.Row="1" x:Name="ItemList" SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  ItemClick="OnItemRowClick">
                            <ListView.ItemTemplate>
                                <!--
                                    用 {Binding} 而不是 {x:Bind}：Window 不是 FrameworkElement，
                                    x:Bind 生成的代码在 Window 根下无法编译。ListView 有虚拟化，开销可忽略。
                                -->
                                <DataTemplate>
                                    <Grid Padding="0,2" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>

                                        <!--
                                            行内勾选不用 CheckBox：它是模板化控件，每个已实现行都要摊模板与动画资源，
                                            实测 5000 项时独占 46–49MB（179.8MB → 137MB）。
                                            但形态按官方模板 1:1 复刻：20×20、ControlCornerRadius 圆角、官方令牌画刷
                                            （未勾选 Transparent 填充 + ControlStrongStrokeColorDefault 描边——实测官方未勾选态
                                              内部像素与背后面板只差 3，是透明；铺 ControlFillColorDefault 会明显发白；
                                             已勾选 AccentFillColorDefault + TextOnAccentFillColorPrimary）、
                                            E73E 勾字形、12px。
                                            差异只有一处：官方有 PointerOver/Pressed 过渡动画，这里没有（那需要模板化控件）。
                                            ⚠ 不能用 CheckBoxFillUnchecked/CheckBoxStrokeChecked 这类键——那是 UWP 命名，
                                            WinUI 3 里不存在，用了会在 XAML 解析期抛 "Cannot find a Resource"。
                                        -->
                                        <Grid Grid.Column="0" Background="Transparent">
                                            <Grid Width="20" Height="20"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="20" Height="20" CornerRadius="{ThemeResource ControlCornerRadius}"
                                                                                                        BorderThickness="1"
                                                                                                        Background="Transparent"
                                                        BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                                        Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                <Border Width="20" Height="20" CornerRadius="{ThemeResource ControlCornerRadius}"
                                                                                                        BorderThickness="1"
                                                                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                        Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="12"
                                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </Grid>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding OriginalName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="12"
                                                  Opacity="0.4" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding NewName}"
                                                   Foreground="{Binding State, Converter={StaticResource StateBrush}}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Message}"
                                                   Foreground="{Binding State, Converter={StaticResource StateBrush}}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 结果条：卡片内底部，右对齐 -->
                        <Grid Grid.Row="2" Padding="12,4,12,8">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" />

                                <!-- 执行期：【取消】与确定态进度条。逐项进度来自 sink 的 PostRenameItem -->
                                <ProgressBar x:Name="BusyBar" Width="120" Height="4" Minimum="0" Maximum="1"
                                             Value="0" Visibility="Collapsed" VerticalAlignment="Center" />
                                <Button x:Name="CancelButton" Content="取消" Visibility="Collapsed"
                                        Click="OnCancelExecute" />

                                <TextBlock x:Name="FooterText"
                                           FontSize="12"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
