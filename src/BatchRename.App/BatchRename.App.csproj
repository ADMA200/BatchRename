<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>BatchRename.App</RootNamespace>
    <AssemblyName>BatchRename.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\bin\publish\BatchRename.App\</PublishDir>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 临时：把 CsWin32 生成代码落盘，便于确认签名 -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    CsWin32 的输入清单必须挂在 AdditionalFiles 上（不是 None）。
    v1.0 规格书 §7.1 写的是 <None Include="..."/>，那样源生成器读不到，等于没配。
  -->
  <ItemGroup>
    <AdditionalFiles Include="Core\NativeMethods.txt" />
  </ItemGroup>

  <!--
    WinUI 3 非打包应用运行时固定查找 exe 同目录的 resources.pri。
    WinAppSDK 2.6.4 的 publish 只产出 <AssemblyName>.pri 且不会重命名，
    缺了它会在 Microsoft.UI.Xaml.dll 里崩成 0xC000027B（启动即闪退，无任何提示）。
  -->
  <Target Name="EnsureResourcesPri" AfterTargets="Publish" Condition="Exists('$(TargetDir)$(AssemblyName).pri')">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri"
          DestinationFiles="$(PublishDir)resources.pri"
          OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="[PRI] $(AssemblyName).pri -> $(PublishDir)resources.pri" />
  </Target>
</Project>
