<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- M3 起 Core 里有 CsWin32 生成的 P/Invoke，必须用 Windows TFM -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>BatchRename.ShellTest</RootNamespace>
    <AssemblyName>BatchRename.ShellTest</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>

  <!-- CsWin32 与 App 共用同一份输入清单，保证两边生成的 API 一致 -->
  <ItemGroup>
    <AdditionalFiles Include="..\BatchRename.App\Core\NativeMethods.txt" />
  </ItemGroup>

  <!--
    直接链接 App 的 Core/Models 源码编译，不引用 App 项目本身：
    App 是 WinUI 3 (net10.0-windows)，控制台引用它会拖进整个 Windows App SDK。
    规格书 §4.3 硬规则要求 Core 不依赖任何 WinUI 类型，这里正好用来验证。
  -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\BatchRename.App\Core\*.cs" LinkBase="Core" />
    <Compile Include="..\BatchRename.App\Models\*.cs" LinkBase="Models" />
    <!-- 断言体与 xUnit 项目共用同一份实现，避免两份断言漂移 -->
    <Compile Include="..\..\tests\BatchRename.Core.Tests\CoreSuite.cs" Link="CoreSuite.cs" />
  </ItemGroup>

</Project>
